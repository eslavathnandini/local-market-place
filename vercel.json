{
  "version": 2,
  "builds": [
    {
      "src": "client/**",
      "use": "@vercel/static-builder",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://service-marketplace-api.onrender.com/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/client/build/index.html" }
  ]
}
